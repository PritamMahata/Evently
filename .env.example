# Postgres connection string (Supabase: Project Settings -> Database -> Connection string).
# On Vercel use the pooled "Transaction pooler" string (port 6543).
DATABASE_URL="your_database_url_here"

# Direct (non-pooled) connection used only for migrations/seeding. Optional locally.
DIRECT_URL="your_direct_database_url_here"

# Set to "true" when the database requires TLS (Supabase). Leave "false" for local Postgres.
DATABASE_SSL="false"

# Random string used to hash login rate-limit keys. Generate with: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"

# IANA timezone in which event dates/times are interpreted, e.g. Asia/Kolkata, UTC.
APP_TIMEZONE="UTC"

# Public site URL (used for the CSRF origin check in production), e.g. https://evently.vercel.app
APP_URL="http://localhost:3000"




RESEND_API_KEY=

