    {
      "name": "2. Public Events Discovery",
      "description": "Discovery and filtering endpoints accessible to public visitors and registered attendees.",
      "item": [
        {
          "name": "2.1 List Upcoming Events (All)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ]
            },
            "description": "Lists upcoming active events with real-time seat counts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns list of upcoming events with capacity metrics\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.events).to.be.an(\"array\");",
                  "    pm.expect(json.events.length).to.be.above(0);",
                  "    const first = json.events[0];",
                  "    pm.expect(first).to.have.property(\"id\");",
                  "    pm.expect(first).to.have.property(\"seat_limit\");",
                  "    pm.expect(first).to.have.property(\"registered_count\");",
                  "    pm.environment.set(\"active_event_id\", first.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Filter Events (When: Month, Availability: Available)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events?when=month&availability=available&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "when",
                  "value": "month",
                  "description": ""
                },
                {
                  "key": "availability",
                  "value": "available",
                  "description": ""
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": ""
                }
              ]
            },
            "description": "Verifies date range and availability query filtering on the database level."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered events have remaining seats\", function () {",
                  "    const json = pm.response.json();",
                  "    json.events.forEach(function(evt) {",
                  "        pm.expect(evt.registered_count).to.be.below(evt.seat_limit);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Search Events by Title / Keyword",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events?q=React",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "React",
                  "description": ""
                }
              ]
            },
            "description": "Tests keyword matching across event titles and descriptions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns search matching events\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.events).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Get Single Event Details by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events/{{active_event_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                "{{active_event_id}}"
              ]
            },
            "description": "Fetches single event details including venue, date, time, and seat limits."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns correct event payload\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.event).to.be.an(\"object\");",
                  "    pm.expect(json.event.id).to.eql(pm.environment.get(\"active_event_id\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Attendee Operations & RSVP Business Rules",
      "description": "Tests seat reservations, duplicate prevention (409), .ics calendar downloads, and 1-day RSVP cancellation.",
      "item": [
        {
          "name": "3.1 Switch Session to Demo Attendee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
