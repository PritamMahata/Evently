{
  "info": {
    "_postman_id": "d9b32c10-8f47-4932-b7ca-4700d5a71e89",
    "name": "Evently API - Production & Interview Suite",
    "description": "Complete automated Postman workspace for the Evently Event Booking & RSVP Platform.\n\nDesigned for technical interviews and evaluation to prove that every endpoint is verified with automated assertions:\n- Cookie-based session persistence\n- Role-based access control (ORGANIZER vs ATTENDEE)\n- Event ownership enforcement\n- Concurrency seat-limit validation\n- Unique constraint duplicate RSVP prevention\n- CSV and ICS calendar exports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Session Management",
      "description": "End-to-end verification of registration, token confirmation, login, profile inspection, and logout.",
      "item": [
        {
          "name": "1.1 Sign Up New Attendee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Registers a new attendee account. Validates email format, password complexity, and role selection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Candidate Interviewer\",\n  \"email\": \"candidate.demo.{{$timestamp}}@example.com\",\n  \"password\": \"DemoPassword123\",\n  \"confirmPassword\": \"DemoPassword123\",\n  \"role\": \"ATTENDEE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains user object with ATTENDEE role\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"user\");",
                  "    pm.expect(json.user.role).to.eql(\"ATTENDEE\");",
                  "    pm.expect(json.user.email).to.include(\"candidate.demo.\");",
                  "    pm.environment.set(\"registered_user_email\", json.user.email);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Resend Email Confirmation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
