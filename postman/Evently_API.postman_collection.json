              "raw": "{{base_url}}/api/auth/resend-confirmation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-confirmation"
              ]
            },
            "description": "Generates a fresh confirmation token for unverified accounts and returns token for evaluation environments.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registered_user_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns confirmation token for automated test flow\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.ok).to.be.true;",
                  "    if (json.token) {",
                  "        pm.environment.set(\"confirmation_token\", json.token);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
