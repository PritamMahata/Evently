            },
            "description": "Generates standard RFC 5545 iCalendar invite for calendar export."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns valid calendar format\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/calendar\");",
                  "    pm.expect(pm.response.text()).to.include(\"BEGIN:VCALENDAR\");",
                  "    pm.expect(pm.response.text()).to.include(\"SUMMARY:\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Cancel RSVP (1-day Policy Enforced)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events/{{active_event_id}}/register/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                "{{active_event_id}}",
                "register",
                "cancel"
              ]
            },
            "description": "Cancels registration and reclaims capacity if requested at least 1 day before event date."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cancellation processed (200) or Policy Rejection (400)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Seat returned to event pool\", function () {",
                  "        pm.expect(pm.response.json().cancelled).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Organizer Operations & RBAC",
      "description": "Event lifecycle management: creation, PATCH updates, attendee rosters, CSV export, and cancellation.",
      "item": [
