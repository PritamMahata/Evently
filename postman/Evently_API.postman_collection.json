          ]
        },
        {
          "name": "3.2 Register for Event (Reserve Seat)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events/{{active_event_id}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                "{{active_event_id}}",
                "register"
              ]
            },
            "description": "Executes transactional seat reservation with row locking."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registration successful (201) or Already Registered (409)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Seat registered with CONFIRMED status\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.registration.status).to.eql(\"CONFIRMED\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Verify Duplicate Registration Blocked (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events/{{active_event_id}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                "{{active_event_id}}",
                "register"
              ]
            },
            "description": "Proves database unique constraint (event_id, user_id) stops double registrations."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Error indicates already registered\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(\"ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ]
        },
